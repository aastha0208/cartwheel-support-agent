# macOS
.DS_Store

# Secrets. Never commit keys.
.env

# Generated world data. Recreate with: uv run python -m seed.generate
data/cartwheel.db

# Local conversation state and scenario/replay run outputs.
.sessions.db*
scenarios/results/
replay/results/

# Rolling per-save backups of annotations.json (analysis/review_app/server.py) —
# local recovery safety net, not meant to be committed.
analysis/state/.annotation_backups/

# Scratch/debug files (dumps, one-off check scripts, artifact preview copies) —
# session working files, not deliverables.
.tmp/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
scenarios/demo_pilot_gt.json
